{
  "framework": "vite",
  "installCommand": "npm ci --force",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "VITE_COMPRESSED": "1",
      "VITE_MUSIC": "1",
      "VITE_WHISPERS_COUNT": "30"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
